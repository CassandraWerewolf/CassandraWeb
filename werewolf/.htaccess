#AuthType Basic
#AuthName "Cassandra"
#AuthUserFile /var/www/passwds/cassandra
#Require valid-user

Redirect 301 /show_games_missing_info.php /show_games.php?type=missing_info

RewriteEngine on
RewriteRule ^player/(.*)/games_played$ /players/show_user_games_played.php?player=$1 [B]
RewriteRule ^player/(.*)/games_modded$ /players/show_user_games_modded.php?player=$1 [B]
RewriteRule ^player/(.*)/with$ /players/show_played_with.php?player=$1 [B]
RewriteRule ^player/(.*)/with/(.*)$ /players/show_played_with.php?player=$1&player2=$2 [B]
RewriteRule ^player/(.*)$ /players/show_player_stats.php?player=$1 [B]
RewriteRule ^profile/(.*)$ /players/show_player_profile.php?player=$1 [B]

RewriteRule ^game/(.*)/votes$ /show_game_votes.php?thread_id=$1 [B]
RewriteRule ^game/(.*)/votes/xml$ /show_game_votes_xml.php?thread_id=$1 [B]
RewriteRule ^game/(.*)/tally_inverted$ /show_game_tally_inverted.php?thread_id=$1 [B]
RewriteRule ^game/(.*)/tally$ /show_game_tally.php?thread_id=$1 [B]
RewriteRule ^game/(.*)/chat$ /game_chat.php?thread_id=$1 [B]
RewriteRule ^game/(.*)/chat/room=(.*)$ /game_chat.php?thread_id=$1&go_to_room=$2 [B]
RewriteRule ^game/(.*)/chat/tab=(.*)$ /game_chat.php?thread_id=$1&tab=$2 [B]
RewriteRule ^game/(.*)/(.*)$ /get_user_post.php?thread_id=$1&player=$2 [B]
RewriteRule ^game/(.*)$ /show_game_stats.php?thread_id=$1 [B]

RewriteRule ^competition/game/(.*)/(.*)$ /get_user_post.php?thread_id=$1&player=$2 [B]
RewriteRule ^competition/game/(.*)$ /competition/cc_show_game_stats.php?thread_id=$1 [B]
RewriteRule ^chat/$ chat.php
